{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Native Node ESM: relative imports carry an explicit .js extension. */
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",

    /* Type-check only. The server is never deployed, so there is no dist/ to ship —
       `npm run build` exists so a type error fails CI. See plan/BE/README.md. */
    "noEmit": true,

    /* Strictness — matches the client (plan/FE/01-setup.md) */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "scripts", "vitest.config.ts"]
}
