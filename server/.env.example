# Copy to server/.env and set a real secret. server/.env is gitignored.
#
# Generate one:  node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
#
# The server refuses to boot if JWT_SECRET is missing or shorter than 32 characters.
# There is deliberately no hardcoded fallback — a development default is how a real
# secret ends up committed later.
JWT_SECRET=

# Access token lifetime. Short, because a JWT cannot be revoked before it expires.
# Set to 30s to make the silent-refresh cycle observable in DevTools during review.
ACCESS_TOKEN_TTL=15m

# Refresh token lifetime. Revocable server-side, so it can be longer.
REFRESH_TOKEN_TTL=1d
